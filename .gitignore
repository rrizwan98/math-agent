lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.memo
.venv
venv
ENV/
env/
.env
.venv/
bin/
include/
lib/
# General
.DS_Store
.vscode/
.idea/
.log
*.tmp
*.swp
